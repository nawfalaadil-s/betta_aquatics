# BETTA AQUATICS ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure your Supabase Project keys

# Supabase PostgreSQL & Auth Credentials
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Store Defaults
VITE_STORE_NAME="Betta Aquatics"
VITE_DEFAULT_CURRENCY="INR"
VITE_CURRENCY_SYMBOL="₹"

# Note: Never expose Supabase Service-Role secret key in frontend application!
